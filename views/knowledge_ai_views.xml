<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hjig_knowledge_list" model="ir.ui.view"><field name="name">hjig.knowledge.item.list</field><field name="model">hjig.knowledge.item</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-muted="state in ['superseded', 'obsolete']"><field name="code"/><field name="title"/><field name="category"/><field name="version"/><field name="project_id"/><field name="source_standard"/><field name="effective_date"/><field name="state"/></list></field></record>
    <record id="view_hjig_knowledge_form" model="ir.ui.view"><field name="name">hjig.knowledge.item.form</field><field name="model">hjig.knowledge.item</field><field name="arch" type="xml"><form><header><button name="action_submit_review" string="Reviewer Submit" type="object" class="btn-primary" invisible="state not in ['draft', 'rejected']"/><button name="action_apply_decision" string="Apply Decision" type="object" class="btn-primary" invisible="state != 'review'"/><field name="state" widget="statusbar" statusbar_visible="draft,review,approved,rejected,superseded,obsolete"/></header><sheet><div class="oe_title"><h1><field name="title"/></h1></div><group><group><field name="code"/><field name="category"/><field name="version"/><field name="project_id"/><field name="effective_date"/><field name="owner_id"/><field name="reviewer_designation_id"/><field name="reviewed_by_id"/><field name="reviewed_date"/><field name="approver_designation_id"/></group><group><field name="source_standard"/><field name="source_url" widget="url"/><field name="attachment_ids" widget="many2many_binary"/><field name="supersedes_id"/><field name="superseded_by_id"/><field name="approval_id"/></group></group><field name="applicability"/><field name="controlled_content" widget="html"/></sheet><chatter/></form></field></record>

    <record id="view_hjig_ai_log_list" model="ir.ui.view"><field name="name">hjig.ai.assistance.log.list</field><field name="model">hjig.ai.assistance.log</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="code"/><field name="project_id"/><field name="target_ref"/><field name="capability"/><field name="model_identity"/><field name="confidence"/><field name="authoritative"/><field name="run_date"/><field name="disposition"/></list></field></record>
    <record id="view_hjig_ai_log_form" model="ir.ui.view"><field name="name">hjig.ai.assistance.log.form</field><field name="model">hjig.ai.assistance.log</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_accept" string="Accept Assistance" type="object" class="btn-primary" invisible="disposition != 'informational'"/><button name="action_reject" string="Reject Assistance" type="object" invisible="disposition != 'informational'"/><field name="disposition" widget="statusbar" statusbar_visible="informational,accepted,edited,rejected"/></header><sheet><div class="oe_title"><h1><field name="code"/></h1></div><group><group><field name="project_id"/><field name="target_ref"/><field name="capability"/><field name="model_identity"/><field name="permission_scope"/><field name="run_date"/></group><group><field name="confidence"/><field name="authoritative"/><field name="reviewed_by_id"/><field name="reviewed_date"/></group></group><field name="output_summary"/><field name="warnings"/><field name="knowledge_source_ids" widget="many2many_tags"/><field name="evidence_source_ids" widget="many2many_tags"/><field name="review_notes"/></sheet></form></field></record>

    <record id="action_hjig_knowledge" model="ir.actions.act_window"><field name="name">Engineering Knowledge Bank</field><field name="res_model">hjig.knowledge.item</field><field name="view_mode">list,form</field></record>
    <record id="action_hjig_ai_log" model="ir.actions.act_window"><field name="name">AI Assistance History</field><field name="res_model">hjig.ai.assistance.log</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_hjig_knowledge" name="Engineering Knowledge Bank" parent="menu_hjig_governance_foundation" action="action_hjig_knowledge" sequence="75"/>
    <menuitem id="menu_hjig_ai_log" name="AI Assistance History" parent="menu_hjig_governance_foundation" action="action_hjig_ai_log" sequence="80"/>
</odoo>
