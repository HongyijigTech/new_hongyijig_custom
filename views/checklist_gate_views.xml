<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hjig_checklist_template_list" model="ir.ui.view"><field name="name">hjig.checklist.template.list</field><field name="model">hjig.checklist.template</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="version"/><field name="stage_id"/><field name="owner_designation_id"/><field name="active"/></list></field></record>
    <record id="view_hjig_checklist_template_form" model="ir.ui.view"><field name="name">hjig.checklist.template.form</field><field name="model">hjig.checklist.template</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="version"/><field name="stage_id"/><field name="owner_designation_id"/><field name="active"/></group><group><field name="purpose"/></group></group><field name="item_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="item_code"/><field name="title"/><field name="instruction"/><field name="blocking"/><field name="evidence_required"/><field name="source_record_type"/></list></field></sheet><chatter/></form></field></record>

    <record id="view_hjig_checklist_list" model="ir.ui.view"><field name="name">hjig.checklist.list</field><field name="model">hjig.checklist</field><field name="arch" type="xml"><list decoration-success="readiness == 'pass'" decoration-danger="readiness == 'fail'"><field name="code"/><field name="project_id"/><field name="template_id"/><field name="stage_id"/><field name="target_ref"/><field name="readiness"/><field name="state"/></list></field></record>
    <record id="view_hjig_checklist_form" model="ir.ui.view"><field name="name">hjig.checklist.form</field><field name="model">hjig.checklist</field><field name="arch" type="xml"><form><header><button name="action_start" string="Start" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_mark_ready" string="Mark Ready" type="object" class="btn-primary" invisible="state not in ['draft', 'in_progress']"/><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,ready,closed"/></header><sheet><div class="oe_title"><h1><field name="code"/></h1></div><group><group><field name="project_id"/><field name="target_ref"/><field name="template_id"/><field name="stage_id"/><field name="gate_id"/></group><group><field name="readiness"/><field name="blocking_summary"/></group></group><field name="response_ids"><list><field name="item_code"/><field name="title"/><field name="blocking"/><field name="evidence_required"/><field name="result"/><field name="evidence_ids" widget="many2many_tags"/><field name="comments"/><field name="verified_by_id"/></list></field></sheet><chatter/></form></field></record>

    <record id="view_hjig_checklist_response_form" model="ir.ui.view"><field name="name">hjig.checklist.response.form</field><field name="model">hjig.checklist.response</field><field name="arch" type="xml"><form><header><button name="action_pass" string="Pass" type="object" class="btn-primary"/><button name="action_fail" string="Fail" type="object"/><button name="action_not_applicable" string="Not Applicable" type="object"/><field name="result" widget="statusbar" statusbar_visible="pending,pass,fail,not_applicable"/></header><sheet><group><group><field name="checklist_id"/><field name="template_item_id"/><field name="item_code"/><field name="title"/><field name="blocking"/><field name="evidence_required"/></group><group><field name="evidence_ids" widget="many2many_tags"/><field name="verified_by_id"/><field name="verified_date"/></group></group><field name="comments"/></sheet></form></field></record>

    <record id="view_hjig_gate_list" model="ir.ui.view"><field name="name">hjig.gate.list</field><field name="model">hjig.gate</field><field name="arch" type="xml"><list decoration-success="state == 'go'" decoration-danger="state == 'no_go'"><field name="code"/><field name="project_id"/><field name="stage_id"/><field name="cycle"/><field name="target_ref"/><field name="readiness"/><field name="state"/></list></field></record>
    <record id="view_hjig_gate_form" model="ir.ui.view"><field name="name">hjig.gate.form</field><field name="model">hjig.gate</field><field name="arch" type="xml"><form><header><button name="action_request_decision" string="Request Decision" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_apply_decision" string="Apply Decision" type="object" class="btn-primary" invisible="state != 'pending'"/><field name="state" widget="statusbar" statusbar_visible="draft,pending,go,no_go"/></header><sheet><div class="oe_title"><h1><field name="code"/></h1></div><group><group><field name="project_id"/><field name="target_ref"/><field name="stage_id"/><field name="cycle"/><field name="approval_authority_designation_id"/><field name="approval_id"/></group><group><field name="readiness"/><field name="blocking_summary"/><field name="decision_notes"/></group></group><field name="checklist_ids"><list><field name="code"/><field name="template_id"/><field name="stage_id"/><field name="readiness"/><field name="state"/></list></field></sheet><chatter/></form></field></record>

    <record id="action_hjig_checklist_template" model="ir.actions.act_window"><field name="name">Checklist Templates</field><field name="res_model">hjig.checklist.template</field><field name="view_mode">list,form</field></record>
    <record id="action_hjig_checklist" model="ir.actions.act_window"><field name="name">Checklists</field><field name="res_model">hjig.checklist</field><field name="view_mode">list,form</field></record>
    <record id="action_hjig_gate" model="ir.actions.act_window"><field name="name">Gate Decisions</field><field name="res_model">hjig.gate</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_hjig_checklist" name="Checklists" parent="menu_hjig_governance_foundation" action="action_hjig_checklist" sequence="50"/>
    <menuitem id="menu_hjig_gate" name="Gate Decisions" parent="menu_hjig_governance_foundation" action="action_hjig_gate" sequence="60"/>
    <menuitem id="menu_hjig_checklist_template" name="Checklist Templates" parent="menu_hjig_governance_foundation" action="action_hjig_checklist_template" sequence="90" groups="project.group_project_manager"/>
</odoo>
