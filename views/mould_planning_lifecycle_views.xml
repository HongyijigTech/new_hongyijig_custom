<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_x_mould_form_lifecycle" model="ir.ui.view">
        <field name="name">x.mould.form.complete.lifecycle</field>
        <field name="model">x_mould</field>
        <field name="inherit_id" ref="new_hongyijig_custom.view_x_mould_native_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_confirm_architecture_baseline" type="object" string="Confirm TG-01 Baseline"
                        class="btn-secondary" invisible="x_lifecycle_stage != 'tg01' or x_baseline_confirmed"/>
                <button name="action_advance_lifecycle" type="object" string="Complete Stage &amp; Move Forward"
                        class="btn-primary" invisible="x_lifecycle_stage == 'closure'"/>
                <field name="x_lifecycle_stage" widget="statusbar" statusbar_visible="ig01,tg01,tg02,tg03,closure"/>
            </xpath>
            <xpath expr="//sheet/div[contains(@class, 'oe_title')]" position="before">
                <div class="oe_button_box" name="lifecycle_button_box"/>
                <group>
                    <group>
                        <field name="x_mould_image" widget="image" class="oe_avatar" options="{'preview_image': 'x_mould_image'}"/>
                    </group>
                    <group string="Current Stage Readiness">
                        <field name="x_stage_ready" widget="boolean_toggle" readonly="1"/>
                        <field name="x_stage_blockers" readonly="1" nolabel="1" placeholder="This stage is ready."/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="IG-01 Planning Basis" name="mould_ig01_basis">
                    <group>
                        <group string="Architecture">
                            <field name="x_special_technology"/>
                            <field name="x_planning_confidence"/>
                            <field name="x_grouping_basis" invisible="x_mould_configuration != 'family'"/>
                            <field name="x_cavitation_confirmed"/>
                            <field name="x_cavity_engineering_justification"/>
                        </group>
                        <group string="Assumptions and Inputs">
                            <field name="x_planning_assumption"/>
                            <field name="x_open_technical_question"/>
                            <field name="x_customer_input_pending"/>
                            <field name="x_engineering_input_pending"/>
                            <field name="x_risk_flag"/>
                            <field name="x_risk_note" invisible="not x_risk_flag"/>
                        </group>
                    </group>
                    <group string="TG-01 Controlled Baseline">
                        <group><field name="x_baseline_confirmed"/><field name="x_baseline_by_id"/><field name="x_baseline_date"/></group>
                        <group><field name="x_baseline_revision"/><field name="x_baseline_note"/></group>
                    </group>
                    <group string="Controlled Family-Mould KRT Architecture" invisible="x_mould_configuration != 'family'">
                        <field name="x_geometry_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/><field name="code"/><field name="name"/>
                                <field name="cavity_quantity"/><field name="krt_label" readonly="1"/>
                                <field name="material_colour_summary" readonly="1"/><field name="active"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Size &amp; Machine Compatibility" name="mould_machine">
                    <group string="Mould Size and Tool Life">
                        <group><field name="x_mould_length_mm"/><field name="x_mould_width_mm"/><field name="x_mould_height_mm"/></group>
                        <group><field name="x_estimated_weight_kg"/><field name="x_target_tool_life"/></group>
                    </group>
                    <group string="Proposed / Customer Machine">
                        <group>
                            <field name="x_machine_name"/><field name="x_machine_tonnage"/><field name="x_machine_shot_capacity_g"/>
                            <field name="x_tie_bar_x_mm"/><field name="x_tie_bar_y_mm"/>
                        </group>
                        <group>
                            <field name="x_platen_x_mm"/><field name="x_platen_y_mm"/>
                            <field name="x_machine_min_thickness_mm"/><field name="x_machine_max_thickness_mm"/>
                            <field name="x_machine_daylight_mm"/><field name="x_machine_ejection_stroke_mm"/>
                            <field name="x_handling_capacity_kg"/>
                        </group>
                    </group>
                    <group string="Calculated Engineering Checks">
                        <group><field name="x_total_cavities"/><field name="x_total_shot_weight_g"/><field name="x_required_tonnage"/></group>
                        <group><field name="x_machine_verdict" widget="badge"/><field name="x_machine_check_details" nolabel="1"/></group>
                    </group>
                </page>
                <page string="TG-02 Engineering Definition" name="mould_tg02">
                    <group string="Runner, Gate and Material">
                        <group>
                            <field name="x_runner_brand"/><field name="x_runner_weight_g"/>
                            <field name="x_material_grade"/><field name="x_material_manufacturer"/>
                            <field name="x_material_filler"/><field name="x_material_mfi"/>
                        </group>
                        <group>
                            <field name="x_engineering_shrinkage"/><field name="x_projected_area_cm2"/>
                            <field name="x_planner_tonnage"/><field name="x_dfm_reference"/><field name="x_moldflow_reference"/>
                        </group>
                    </group>
                    <group string="Steel, Hardness and Treatment">
                        <group><field name="x_base_hardness"/><field name="x_core_hardness"/><field name="x_cavity_hardness"/></group>
                        <group><field name="x_heat_treatment"/><field name="x_surface_treatment"/></group>
                    </group>
                </page>
                <page string="TG-03 Release &amp; Freeze" name="mould_tg03">
                    <group>
                        <group string="Release Authority">
                            <field name="x_toolmaker"/><field name="x_tool_design_reference"/>
                            <field name="x_engineering_approved_by"/><field name="x_engineering_approval_date"/><field name="x_steel_go_ahead"/>
                        </group>
                        <group string="Engineering Release Checks">
                            <field name="x_dfm_approved"/><field name="x_moldflow_approved"/><field name="x_moldflow_not_applicable"/>
                            <field name="x_tool_design_approved"/><field name="x_final_cavitation_approved"/>
                            <field name="x_runner_gate_approved"/><field name="x_tool_steel_approved"/>
                            <field name="x_cooling_frozen"/><field name="x_ejection_frozen"/><field name="x_major_risks_accepted"/>
                        </group>
                    </group>
                </page>
                <page string="Closure / As-Built" name="mould_closure">
                    <group string="As-Built Definition">
                        <group>
                            <field name="x_as_built_configuration"/><field name="x_as_built_special_technology"/>
                            <field name="x_actual_cavitation"/><field name="x_actual_runner"/><field name="x_actual_gate"/><field name="x_actual_steel"/>
                        </group>
                        <group>
                            <field name="x_as_built_length_mm"/><field name="x_as_built_width_mm"/>
                            <field name="x_as_built_height_mm"/><field name="x_as_built_weight_kg"/>
                        </group>
                    </group>
                    <group string="Trial, Handover and Acceptance">
                        <group><field name="x_trial_reference"/><field name="x_buyoff_reference"/><field name="x_dispatch_status"/></group>
                        <group><field name="x_final_ecn_history"/><field name="x_final_acceptance"/></group>
                    </group>
                </page>
                <page string="Controlled Change History" name="mould_history">
                    <group><field name="x_change_reason" placeholder="Enter before changing a controlled field from TG-01 onward"/></group>
                    <field name="x_change_log_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="change_date"/><field name="part_id"/><field name="field_name"/>
                            <field name="old_value"/><field name="new_value"/><field name="reason"/>
                            <field name="lifecycle_stage"/><field name="revision"/><field name="changed_by_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_x_mould_part_form_lifecycle" model="ir.ui.view">
        <field name="name">x.mould.part.form.complete.lifecycle</field>
        <field name="model">x_mould_part</field>
        <field name="inherit_id" ref="new_hongyijig_custom.view_x_mould_part_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]//group/group[last()]" position="inside">
                <field name="x_colour"/><field name="x_remarks"/>
            </xpath>
            <xpath expr="//notebook/page[2]//group/group[1]" position="inside">
                <field name="x_geometry_id" invisible="x_mould_configuration != 'family'"/>
                <field name="x_geometry_group" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Part Size &amp; Change Control">
                    <group>
                        <group string="Part Size in Moulding Orientation">
                            <field name="x_dimension_x_mm"/><field name="x_dimension_y_mm"/><field name="x_dimension_z_mm"/>
                        </group>
                        <group string="Controlled Changes">
                            <field name="x_change_reason" placeholder="Required for controlled changes from TG-01 onward"/>
                            <field name="x_deactivation_reason" invisible="x_active"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hjig_evidence_kanban_images" model="ir.ui.view">
        <field name="name">hjig.evidence.link.kanban.images</field>
        <field name="model">hjig.evidence.link</field>
        <field name="arch" type="xml">
            <kanban default_group_by="image_stage">
                <field name="code"/><field name="image_1920"/><field name="image_caption"/>
                <field name="target_ref"/><field name="verification_state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <field name="image_1920" widget="image" class="w-100"/>
                            <strong><field name="image_caption"/></strong>
                            <div><field name="code"/> - <field name="target_ref"/></div>
                            <field name="verification_state" widget="badge"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hjig_evidence_form_images" model="ir.ui.view">
        <field name="name">hjig.evidence.link.form.images</field>
        <field name="model">hjig.evidence.link</field>
        <field name="inherit_id" ref="new_hongyijig_custom.view_hjig_evidence_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[contains(@class, 'oe_title')]" position="before">
                <group>
                    <group><field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/></group>
                    <group><field name="image_caption"/><field name="image_stage"/></group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_project_form_hjig_image_evidence" model="ir.ui.view">
        <field name="name">project.project.form.hjig.image.evidence</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_hjig_image_evidence" type="object" class="oe_stat_button" icon="fa-camera">
                    <field name="hjig_image_evidence_count" widget="statinfo" string="Images"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
