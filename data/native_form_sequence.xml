<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="sequence_hjig_mould" model="ir.sequence">
        <field name="name">Mould Planning Number</field>
        <field name="code">hjig.mould</field>
        <field name="prefix">MPL/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_hjig_inspection_report" model="ir.sequence">
        <field name="name">Native Inspection Report Number</field>
        <field name="code">hjig.inspection.report</field>
        <field name="prefix">INSP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_hjig_final_mould_plan" model="ir.sequence">
        <field name="name">Final Mould Plan Number</field><field name="code">hjig.final.mould.plan</field>
        <field name="prefix">FMP/%(year)s/</field><field name="padding">4</field><field name="company_id" eval="False"/>
    </record>
    <record id="sequence_hjig_project_risk" model="ir.sequence">
        <field name="name">Project Risk Number</field><field name="code">hjig.project.risk</field>
        <field name="prefix">RISK/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="sequence_hjig_project_issue" model="ir.sequence">
        <field name="name">Project Issue Number</field><field name="code">hjig.project.issue</field>
        <field name="prefix">ISS/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="sequence_hjig_project_ecn" model="ir.sequence">
        <field name="name">Engineering Change Notice Number</field><field name="code">hjig.project.ecn</field>
        <field name="prefix">ECN/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
</odoo>
