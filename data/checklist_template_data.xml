<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="checklist_template_pa00" model="hjig.checklist.template">
        <field name="code">PA-00-READINESS</field><field name="name">Project Activation Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_pa00"/><field name="owner_designation_id" ref="designation_project_coordinator"/>
        <field name="purpose">Confirm that the project, people, customer inputs and document controls are ready before governed execution begins.</field>
    </record>
    <record id="check_pa00_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_pa00"/><field name="sequence">10</field><field name="item_code">PA00-01</field><field name="title">Project master is complete</field><field name="instruction">Read the live Project Master and confirm project identity, customer, scope owner and target dates.</field><field name="source_record_type">live_record</field></record>
    <record id="check_pa00_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_pa00"/><field name="sequence">20</field><field name="item_code">PA00-02</field><field name="title">Governed project team is assigned</field><field name="instruction">Confirm the Hongyi Project Team and required designation holders are assigned in Odoo.</field><field name="source_record_type">live_record</field></record>
    <record id="check_pa00_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_pa00"/><field name="sequence">30</field><field name="item_code">PA00-03</field><field name="title">Customer inputs are registered</field><field name="instruction">Confirm every received customer document is registered with source, revision and evidence link.</field><field name="source_record_type">live_record</field></record>
    <record id="check_pa00_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_pa00"/><field name="sequence">40</field><field name="item_code">PA00-04</field><field name="title">Commercial activation evidence exists</field><field name="instruction">Confirm the order, agreed commercial trigger or approved activation exception is linked.</field><field name="source_record_type">live_record</field></record>
    <record id="check_pa00_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_pa00"/><field name="sequence">50</field><field name="item_code">PA00-05</field><field name="title">Document-control route is confirmed</field><field name="instruction">Human confirmation that the team knows where controlled customer and internal records will be maintained.</field><field name="source_record_type">confirmation</field><field name="evidence_required" eval="False"/></record>

    <record id="checklist_template_tg01" model="hjig.checklist.template">
        <field name="code">TG-01-READINESS</field><field name="name">Scope, Design and Toolmaker Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg01"/><field name="owner_designation_id" ref="designation_project_manager"/>
        <field name="purpose">Verify frozen scope, BOP, design, mould planning, risk and supplier-selection evidence without duplicating those records.</field>
    </record>
    <record id="check_tg01_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">10</field><field name="item_code">TG01-01</field><field name="title">SOR is frozen and phase-mapped</field><field name="instruction">Read the approved SOR baseline; confirm every specified requirement has acceptance criteria and assigned verification phases.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg01_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">20</field><field name="item_code">TG01-02</field><field name="title">BOP is locked or declared not applicable</field><field name="instruction">Read the authoritative BOP lock record. Do not recreate BOP lines in this checklist.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg01_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">30</field><field name="item_code">TG01-03</field><field name="title">Product design is approved</field><field name="instruction">Confirm approved design revision and customer/design authority evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg01_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">40</field><field name="item_code">TG01-04</field><field name="title">Mould planning is internally consistent</field><field name="instruction">Read the existing Mould Planning record and confirm component hierarchy, configuration, KRT/QPS separation and known assumptions.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg01_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">50</field><field name="item_code">TG01-05</field><field name="title">Risks and design challenges are dispositioned</field><field name="instruction">Read the existing Risk and Design Challenge registers; confirm no blocking open item is hidden or duplicated here.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg01_06" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg01"/><field name="sequence">60</field><field name="item_code">TG01-06</field><field name="title">Toolmaker selection is approved</field><field name="instruction">Confirm supplier feasibility, responsibility, technical comparison and commercial selection evidence.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg02" model="hjig.checklist.template">
        <field name="code">TG-02-READINESS</field><field name="name">Pre-Tooling and Steel GO Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg02"/><field name="owner_designation_id" ref="designation_tool_design"/>
        <field name="purpose">Confirm the approved engineering package and human Steel GO decision before manufacturing starts.</field>
    </record>
    <record id="check_tg02_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">10</field><field name="item_code">TG02-01</field><field name="title">Final mould plan is approved</field><field name="instruction">Read the frozen Final Mould Plan and its approval; do not copy mould-planning fields.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg02_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">20</field><field name="item_code">TG02-02</field><field name="title">DFM and Moldflow decisions are closed</field><field name="instruction">Confirm approved DFM and Moldflow records or an authorised not-applicable decision.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg02_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">30</field><field name="item_code">TG02-03</field><field name="title">Tool design revision is approved</field><field name="instruction">Confirm tool design approval and released drawing revision evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg02_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">40</field><field name="item_code">TG02-04</field><field name="title">Machine compatibility is acceptable</field><field name="instruction">Confirm shot capacity, cavitation, mould size and tie-bar checks with PASS/WARN evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg02_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">50</field><field name="item_code">TG02-05</field><field name="title">Steel authority and traceability are approved</field><field name="instruction">Confirm tool-steel grade, source, certificate requirement and authorised Steel GO evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg02_06" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg02"/><field name="sequence">60</field><field name="item_code">TG02-06</field><field name="title">Blocking risks and assumptions are closed</field><field name="instruction">Read the authoritative Risk register and confirm pre-tooling blockers are closed or formally accepted.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg03" model="hjig.checklist.template">
        <field name="code">TG-03-READINESS</field><field name="name">Tool Manufacturing and T0 Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg03"/><field name="owner_designation_id" ref="designation_tool_development"/>
        <field name="purpose">Control China tooling start, progress, deviations and trial readiness through linked execution reports.</field>
    </record>
    <record id="check_tg03_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg03"/><field name="sequence">10</field><field name="item_code">TG03-01</field><field name="title">Manufacturing start authority exists</field><field name="instruction">Confirm approved Tooling Kick-off and Manufacturing Plan reports.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg03_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg03"/><field name="sequence">20</field><field name="item_code">TG03-02</field><field name="title">Steel identity is verified</field><field name="instruction">Confirm approved steel certificate and physical marking/photo evidence match the released plan.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg03_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg03"/><field name="sequence">30</field><field name="item_code">TG03-03</field><field name="title">Current progress report is approved</field><field name="instruction">Read the latest weekly tooling report, plan variance, evidence and next-week plan.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg03_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg03"/><field name="sequence">40</field><field name="item_code">TG03-04</field><field name="title">Deviations and supplier actions are controlled</field><field name="instruction">Confirm all deviations, recovery actions and overdue supplier actions are visible in their live records.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg03_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg03"/><field name="sequence">50</field><field name="item_code">TG03-05</field><field name="title">T0 readiness is approved</field><field name="instruction">Confirm approved Trial Readiness report, trial conditions, material, machine and measurement arrangements.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg04" model="hjig.checklist.template">
        <field name="code">TG-04-READINESS</field><field name="name">T0 to T1 Validation Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg04"/><field name="owner_designation_id" ref="designation_quality_inspection"/>
        <field name="purpose">Verify T0 evidence, SOR trial points and corrective-action control before T1.</field>
    </record>
    <record id="check_tg04_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg04"/><field name="sequence">10</field><field name="item_code">TG04-01</field><field name="title">T0 trial report is approved</field><field name="instruction">Read the approved T0 Trial Report, conditions, result and evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg04_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg04"/><field name="sequence">20</field><field name="item_code">TG04-02</field><field name="title">Required inspections are completed</field><field name="instruction">Confirm applicable visual, assembly and dimensional inspections are approved against the current drawing revision.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg04_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg04"/><field name="sequence">30</field><field name="item_code">TG04-03</field><field name="title">SOR trial verification points are recorded</field><field name="instruction">Read the SOR verification matrix and confirm all points assigned to this trial have evidence-backed results.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg04_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg04"/><field name="sequence">40</field><field name="item_code">TG04-04</field><field name="title">Corrective actions have owners and dates</field><field name="instruction">Confirm every T0 failure or conditional result has a controlled action, owner, due date and re-verification plan.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg04_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg04"/><field name="sequence">50</field><field name="item_code">TG04-05</field><field name="title">Customer feedback is captured</field><field name="instruction">Confirm customer trial feedback or an authorised explanation for why customer feedback is not yet applicable.</field><field name="source_record_type">live_record</field><field name="blocking" eval="False"/></record>

    <record id="checklist_template_tg05" model="hjig.checklist.template">
        <field name="code">TG-05-READINESS</field><field name="name">T1 to T2 Validation Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg05"/><field name="owner_designation_id" ref="designation_quality_inspection"/>
        <field name="purpose">Verify T1 results and effective closure of the prior trial loop before T2.</field>
    </record>
    <record id="check_tg05_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg05"/><field name="sequence">10</field><field name="item_code">TG05-01</field><field name="title">T1 trial and inspection evidence is approved</field><field name="instruction">Read the approved T1 trial and applicable inspection reports.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg05_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg05"/><field name="sequence">20</field><field name="item_code">TG05-02</field><field name="title">Previous corrective actions are verified</field><field name="instruction">Confirm previous actions are evidence-verified, not merely marked complete by the supplier.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg05_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg05"/><field name="sequence">30</field><field name="item_code">TG05-03</field><field name="title">SOR trial points are updated</field><field name="instruction">Confirm SOR points assigned to prototype/trial/final sample show current evidence and disposition.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg05_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg05"/><field name="sequence">40</field><field name="item_code">TG05-04</field><field name="title">New deviations and ECNs are commercially controlled</field><field name="instruction">Read live deviation and ECN records; confirm any customer charge and supplier cost are approved and linked.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg06" model="hjig.checklist.template">
        <field name="code">TG-06-READINESS</field><field name="name">Final Trial and Buy-Off Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg06"/><field name="owner_designation_id" ref="designation_quality_inspection"/>
        <field name="purpose">Confirm final technical acceptance, SOR closure and customer buy-off before dispatch preparation.</field>
    </record>
    <record id="check_tg06_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg06"/><field name="sequence">10</field><field name="item_code">TG06-01</field><field name="title">Final trial report is approved</field><field name="instruction">Confirm final trial conditions, results and evidence are approved.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg06_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg06"/><field name="sequence">20</field><field name="item_code">TG06-02</field><field name="title">Final inspection set is approved</field><field name="instruction">Confirm visual, assembly and dimensional reports required for final acceptance are approved.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg06_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg06"/><field name="sequence">30</field><field name="item_code">TG06-03</field><field name="title">SOR final-sample points are closed</field><field name="instruction">Read the SOR matrix and confirm all required final-sample verifications pass or have an approved exception.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg06_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg06"/><field name="sequence">40</field><field name="item_code">TG06-04</field><field name="title">Open actions are closed with evidence</field><field name="instruction">Confirm supplier, inspection and trial actions are independently verified closed.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg06_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg06"/><field name="sequence">50</field><field name="item_code">TG06-05</field><field name="title">Customer buy-off is approved</field><field name="instruction">Confirm the authorised customer acceptance or approved conditional buy-off evidence.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg07" model="hjig.checklist.template">
        <field name="code">TG-07-READINESS</field><field name="name">Technical Dispatch Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg07"/><field name="owner_designation_id" ref="designation_commercial_logistics"/>
        <field name="purpose">Verify technical, packing, commercial and shipment-authority evidence before dispatch.</field>
    </record>
    <record id="check_tg07_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg07"/><field name="sequence">10</field><field name="item_code">TG07-01</field><field name="title">Mould pre-shipment inspection is approved</field><field name="instruction">Read the approved mould pre-shipment inspection and photo evidence.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg07_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg07"/><field name="sequence">20</field><field name="item_code">TG07-02</field><field name="title">Technical handover dossier is approved</field><field name="instruction">Confirm drawings, certificates, spares, manuals and approved handover dossier are complete.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg07_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg07"/><field name="sequence">30</field><field name="item_code">TG07-03</field><field name="title">Packing and preservation evidence is complete</field><field name="instruction">Confirm packing list, markings, preservation and loading photographs.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg07_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg07"/><field name="sequence">40</field><field name="item_code">TG07-04</field><field name="title">Commercial and shipping documents are approved</field><field name="instruction">Confirm commercial invoice, Incoterm, bill of lading/airway bill requirements and certificate-of-origin records.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg07_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg07"/><field name="sequence">50</field><field name="item_code">TG07-05</field><field name="title">Customer and supplier shipment acknowledgements exist</field><field name="instruction">Confirm both parties acknowledge dispatch scope, destination, responsibility and expected dates.</field><field name="source_record_type">live_record</field></record>

    <record id="checklist_template_tg08" model="hjig.checklist.template">
        <field name="code">TG-08-READINESS</field><field name="name">Shipment and Door-Delivery Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg08"/><field name="owner_designation_id" ref="designation_commercial_logistics"/>
        <field name="purpose">Track shipment, import clearance and delivery evidence without duplicating the logistics documents.</field>
    </record>
    <record id="check_tg08_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg08"/><field name="sequence">10</field><field name="item_code">TG08-01</field><field name="title">Shipment milestones are current</field><field name="instruction">Read the Shipment Tracker and confirm actual departure, arrival, clearance and delivery forecasts.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg08_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg08"/><field name="sequence">20</field><field name="item_code">TG08-02</field><field name="title">Import clearance records are complete</field><field name="instruction">Confirm customs, duty, GST and import-clearance evidence applicable to the agreed Incoterm.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg08_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg08"/><field name="sequence">30</field><field name="item_code">TG08-03</field><field name="title">Door-delivery evidence is accepted</field><field name="instruction">Confirm receipt, package condition, shortages/damage record and customer acknowledgement.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg08_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg08"/><field name="sequence">40</field><field name="item_code">TG08-04</field><field name="title">Delivery exceptions have controlled actions</field><field name="instruction">If any delay, loss or damage exists, confirm its action owner, evidence and commercial responsibility.</field><field name="source_record_type">exception</field><field name="blocking" eval="False"/></record>

    <record id="checklist_template_tg09" model="hjig.checklist.template">
        <field name="code">TG-09-READINESS</field><field name="name">Installation Support and Project Closure Readiness</field><field name="version">1.0</field>
        <field name="stage_id" ref="stage_tg09"/><field name="owner_designation_id" ref="designation_project_manager"/>
        <field name="purpose">Confirm installation support, final acceptance, commercial closure and learning capture. Product warranty is not implied.</field>
    </record>
    <record id="check_tg09_01" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">10</field><field name="item_code">TG09-01</field><field name="title">Installation support is completed</field><field name="instruction">Confirm agreed installation support, site activities and stabilisation evidence are complete.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg09_02" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">20</field><field name="item_code">TG09-02</field><field name="title">Site trial and final acceptance are approved</field><field name="instruction">Confirm site-trial results and authorised customer final acceptance.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg09_03" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">30</field><field name="item_code">TG09-03</field><field name="title">No-warranty service boundary is acknowledged</field><field name="instruction">Human confirmation that closure records state installation support scope and do not activate a product warranty.</field><field name="source_record_type">confirmation</field></record>
    <record id="check_tg09_04" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">40</field><field name="item_code">TG09-04</field><field name="title">Customer and supplier commercials are reconciled</field><field name="instruction">Read verified Customer and Supplier Ledger links, including every approved ECN charge and supplier cost.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg09_05" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">50</field><field name="item_code">TG09-05</field><field name="title">Risks, issues, actions and ECNs are closed</field><field name="instruction">Read the authoritative registers and confirm nothing remains open without an approved residual owner.</field><field name="source_record_type">live_record</field></record>
    <record id="check_tg09_06" model="hjig.checklist.template.item"><field name="template_id" ref="checklist_template_tg09"/><field name="sequence">60</field><field name="item_code">TG09-06</field><field name="title">Lessons learned are approved for the Knowledge Bank</field><field name="instruction">Confirm technical, supplier, commercial and governance lessons are reviewed before becoming authoritative knowledge.</field><field name="source_record_type">live_record</field></record>
</odoo>
