<odoo>
    <record id="group_hjig_sseries_user" model="res.groups">
        <field name="name">Hongyi S-Series User</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May operate assigned S-Series cockpit cases but cannot access immutable raw payloads or approve customer issue.</field>
    </record>

    <record id="group_hjig_sseries_manager" model="res.groups">
        <field name="name">Hongyi S-Series Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hjig_sseries_user'))]"/>
        <field name="comment">May inspect immutable website intake diagnostics and manage S-Series cockpit records. Customer issue and commercial approvals remain separate governed authorities.</field>
    </record>

    <record id="group_hjig_document_controller" model="res.groups">
        <field name="name">LaunchGuard Document Controller</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May approve controlled project documents when the user also holds the required approver designation.</field>
    </record>

    <record id="group_hjig_governance_approver" model="res.groups">
        <field name="name">Hongyi Governance Approver</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May approve or reject governed baselines, engineering decisions, commercial changes and gates when the user also holds the required designation.</field>
    </record>

    <record id="group_hjig_commercial_user" model="res.groups">
        <field name="name">Hongyi Commercial Records User</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May access project customer/supplier commercial links when also assigned to that governed project team. Access to the linked native Odoo document requires a separately assigned native role.</field>
    </record>

