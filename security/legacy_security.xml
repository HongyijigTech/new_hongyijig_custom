<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_hjig_document_controller" model="res.groups">
        <field name="name">LaunchGuard Document Controller</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May approve controlled project documents when the user also holds the required approver designation.</field>
    </record>

    <record id="rule_hjig_project_designation_visibility" model="ir.rule">
        <field name="name">Project Designation Assignment: project visibility</field>
        <field name="model_id" ref="model_hjig_project_designation_assignment"/>
        <field name="domain_force">[('project_id.hjig_authorized_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_hjig_project_designation_company" model="ir.rule">
        <field name="name">Project Designation Assignment: multi-company</field>
        <field name="model_id" ref="model_hjig_project_designation_assignment"/>
        <field name="domain_force">[('project_id.company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_hjig_project_designation_manager" model="ir.rule">
        <field name="name">Project Designation Assignment: manager oversight</field>
        <field name="model_id" ref="model_hjig_project_designation_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

